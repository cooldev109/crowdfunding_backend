# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env on your production server
# and fill in all the values

# Server Configuration
PORT=4000
NODE_ENV=production

# Database (MongoDB with authentication)
# Format: mongodb://username:password@host:port/database
MONGO_URI=mongodb://crowdfunding_user:YOUR_SECURE_PASSWORD@127.0.0.1:27017/crowdfunding_platform

# JWT Configuration
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=YOUR_VERY_LONG_RANDOM_SECRET_KEY_MINIMUM_64_CHARACTERS
JWT_EXPIRES_IN=7d

# Frontend URLs (your production domain)
CLIENT_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==============================================
# PAYMENT GATEWAYS
# ==============================================

# Stripe (International Payments)
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Subscription Price IDs
STRIPE_PRICE_ESENCIAL=price_esencial_id
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual_id
STRIPE_PRICE_PRIME=price_prime_id
STRIPE_PRICE_PRIME_ANNUAL=price_prime_annual_id

# Wompi (Colombian Payment Gateway)
# Get keys from: https://comercios.wompi.co/
WOMPI_PUBLIC_KEY=pub_prod_your_wompi_public_key
WOMPI_PRIVATE_KEY=prv_prod_your_wompi_private_key
WOMPI_EVENTS_SECRET=your_wompi_events_secret
WOMPI_INTEGRITY_SECRET=your_wompi_integrity_secret

# PagSeguro (Brazilian Payments) - Optional
PAGSEGURO_TOKEN=your_pagseguro_token
PAGSEGURO_EMAIL=your_pagseguro_email

# ==============================================
# EMAIL CONFIGURATION (SMTP)
# ==============================================

# Gmail example (use App Password, not regular password)
# Enable 2FA and create App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Or use a transactional email service:
# SendGrid: smtp.sendgrid.net, port 587
# Mailgun: smtp.mailgun.org, port 587
# Amazon SES: email-smtp.{region}.amazonaws.com, port 587

EMAIL_FROM_NAME=InvestFlow
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ==============================================
# FILE STORAGE (CLOUDINARY)
# ==============================================
# Get keys from: https://cloudinary.com/console

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# File Upload Limits
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=.xlsx,.csv,.pdf,.jpg,.jpeg,.png

# ==============================================
# OPTIONAL SERVICES
# ==============================================

# OpenAI (for AI chatbot features)
OPENAI_API_KEY=sk-your-openai-api-key
